index 9251058..b98140f 100644
--- a/WCSim.cc
+++ b/WCSim.cc
@@ -2,6 +2,24 @@
 #include "G4ios.hh"
 #include "G4RunManager.hh"
 #include "G4UImanager.hh"
+#include "G4GDMLParser.hh"  // lumen GDML export: enables /persistency/gdml/write
+#include "G4ExceptionHandler.hh"
+#include "G4StateManager.hh"
+
+namespace {
+  // lumen GDML export: Geant4 11 refuses a property table whose energies descend (mat215), which Geant4 10
+  // accepted; WCSim builds a few for materials other detectors use. Report each one and go on.
+  class LenientMaterialsHandler : public G4ExceptionHandler {
+  public:
+    G4bool Notify(const char* origin, const char* code, G4ExceptionSeverity sev, const char* desc) override {
+      if (G4String(code) == "mat215") {
+        G4cerr << "lumen GDML export: not fatal here: " << code << " " << desc << G4endl;
+        return false;
+      }
+      return G4ExceptionHandler::Notify(origin, code, sev, desc);
+    }
+  };
+}
 #include "G4UIterminal.hh"
 #include "G4UItcsh.hh"
 #include "WCSimDetectorConstruction.hh"
@@ -68,6 +86,8 @@ int main(int argc,char** argv)
 
   // Construct the default run manager
   G4RunManager* runManager = new G4RunManager;
+  G4GDMLParser gdml_parser;  // lumen GDML export: its messenger defines /persistency/gdml/*
+  G4StateManager::GetStateManager()->SetExceptionHandler(new LenientMaterialsHandler);
 
   // get the pointer to the UI manager
   G4UImanager* UI = G4UImanager::GetUIpointer();
